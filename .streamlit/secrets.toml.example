# Copy to secrets.toml locally and replace placeholders. Never commit real secrets.
[paypal]
client_id = "YOUR_SANDBOX_CLIENT_ID"
client_secret = "YOUR_SANDBOX_SECRET"
# Used by the verified Webhook receiver; see docs/SETUP.md for its boundary.
webhook_id = "YOUR_SANDBOX_WEBHOOK_ID"

# Optional: needed for live payment chat and simulated-rule AI explanations.
# Example cases and fixed sample walkthroughs require no OpenAI configuration.
[openai]
api_key = "YOUR_OPENAI_API_KEY"
model = "YOUR_OPENAI_MODEL"
